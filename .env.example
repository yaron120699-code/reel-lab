# ---------------------------------------------------------------------------
# Baderech Competitor Lab — example environment
# Copy to .env and fill in real values. .env is git-ignored; never commit it.
# Every value below is a placeholder. The app builds and runs as-is.
# ---------------------------------------------------------------------------

# Demo mode lets the whole flow run with no external credentials.
# Leave as "true" until you have a live analysis provider configured.
DEMO_MODE=true

# Where the local SQLite file lives (relative paths resolve from the repo root).
DATABASE_FILE=./data/app.db

# Set automatically by the Vercel Supabase integration in cloud deployments.
# Leave empty locally to keep using SQLite.
POSTGRES_URL=

# Where uploaded MP4 files and thumbnails are written during the MVP.
STORAGE_DIR=./data/uploads

# --- Analysis provider -----------------------------------------------------
# fixture   = no network. Serves pre-baked, clearly labelled sample analyses.
# gemini    = live analysis through the Google Gemini generateContent API.
# anthropic = live analysis through the Anthropic Messages API.
ANALYSIS_PROVIDER=fixture

# Only read when ANALYSIS_PROVIDER is not "fixture". Server-side only.
# Never committed, never sent to the browser, never written to a log.
ANALYSIS_API_KEY=

# Match the model to the provider:
#   gemini    -> gemini-2.5-flash-lite   (free tier)
#   anthropic -> claude-sonnet-4-5
ANALYSIS_MODEL=gemini-2.5-flash-lite

# To switch on live Gemini analysis, set:
#   ANALYSIS_PROVIDER=gemini
#   ANALYSIS_API_KEY=<key from Google AI Studio>
#   ANALYSIS_MODEL=gemini-2.5-flash-lite
# Note: the MP4 is NOT sent to Gemini. Analysis runs on caption, transcript and
# public metrics only, so no visual observation can be supported.

# --- Apify (optional) ------------------------------------------------------
# Server-side only. Never referenced from client code, never logged.
# Manual JSON + MP4 import works without it.
APIFY_API_TOKEN=
